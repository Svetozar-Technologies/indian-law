obj_root_laws_the_fiscal_responsibility_and_budget_management_act_2003:
  slug the-fiscal-responsibility-and-budget-management-act-2003
  title `The Fiscal Responsibility and Budget Management Act, 2003`
  localizedTitles obj_root_laws_the_fiscal_responsibility_and_budget_management_act_2003_localized_titles
  actNumber (39)
  actYear (2003)
  enactmentDate 2003-08-26
  ministry `Ministry of Finance`
  department `Department of Economic Affairs`
  longTitle `An Act to provide for the responsibility of the Central Government to ensure inter-generational equity in fiscal management and long-term macro-economic stability by achieving sufficient revenue surplus and removing fiscal impediments in the effective conduct of monetary policy and prudential debt management consistent with fiscal sustainability through limits on the Central Government borrowings, debt and deficits, greater transparency in fiscal operations of the Central Government and conducting fiscal policy in a medium-term framework and for matters connected therewith or incidental thereto.`
  category constitutional
  categoryTags obj_root_laws_the_fiscal_responsibility_and_budget_management_act_2003_category_tags
  sourceUrl `https://www.indiacode.nic.in/handle/123456789/2064`
  sources obj_root_laws_the_fiscal_responsibility_and_budget_management_act_2003_sources
  languages obj_root_laws_the_fiscal_responsibility_and_budget_management_act_2003_languages
